# Extra local build trees
build-*/

# Benchmark references are large and regenerable (benchmarks/render_references.py);
# each results run records their provenance in its run.json. For results,
# keep logs, metadata and plots in git, not the images.
benchmarks/references/
benchmarks/results/*/*/*.pfm
benchmarks/results/*/*/*.png
!benchmarks/results/*/plots/*.png

# Multi-view datasets (benchmarks/make_dataset.py) are large and regenerable.
/datasets/

# Python bytecode
__pycache__/
*.pyc
